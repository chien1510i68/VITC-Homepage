# Environment variables for production
# Copy this file to .env.production and fill in the values

# API URL - Required
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api/v1

# Key-value source for organization structure page
# Example endpoint called by frontend:
# New configuration endpoint example:
#   GET ${NEXT_PUBLIC_ORG_STRUCTURE_API_PATH}
#   Response: {"success":true,"data":{"values":{...}}}
NEXT_PUBLIC_ORG_STRUCTURE_API_PATH=/api/v1/configuration/homepage.org-structure

# Optional: Analytics, Sentry, etc.
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=
